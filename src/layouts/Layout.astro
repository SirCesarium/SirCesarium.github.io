---
import '../styles/global.css';
import CursorEffects from '../components/CursorEffects.astro';
import SeoMeta from '../components/SeoMeta.astro';

interface Props {
	title?: string;
	description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<SeoMeta title={title} description={description} />
	</head>
	<body>
		<slot />

		<CursorEffects />

		<script src="../scripts/scroll-reveal.ts"></script>
	</body>
</html>
