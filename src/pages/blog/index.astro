---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const isProd = import.meta.env.PROD;
const rawPosts = await getCollection('blog');

const posts = rawPosts
	.filter((post) => !isProd || !post.data.draft)
	.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const dateFormatter = new Intl.DateTimeFormat('en-US', {
	year: 'numeric',
	month: 'short',
	day: 'numeric',
});
---

<Layout
	title="Blog — Cesar Marcano"
	description="Articles, technical deep dives, and notes on software engineering, architecture, and systems."
>
	<SiteNav />

	<main class="frame section-frame min-h-[calc(100vh-14rem)]">
		<header class="mb-12 max-w-2xl" data-reveal>
			<a
				href="/"
				class="mb-6 inline-flex items-center gap-1.5 text-xs text-ink-muted transition-colors hover:text-ember"
			>
				<span aria-hidden="true">←</span> Back to home
			</a>
			<h1 class="font-display text-3xl tracking-tight text-ink uppercase sm:text-4xl">
				Blog
			</h1>
		</header>

		{posts.length === 0 ? (
			<div class="rounded-xl border border-line bg-crust/50 p-8 text-center text-ink-muted">
				<p>No articles published yet. Check back soon!</p>
			</div>
		) : (
			<div class="grid gap-6 sm:gap-8">
				{posts.map((post, index) => (
					<article
						data-reveal
						style={`--i: ${index}`}
						class="group relative rounded-xl border border-line bg-crust/60 p-6 transition-all hover:border-ember/50 hover:bg-line/20 sm:p-8"
					>
						<div class="mb-3 flex flex-wrap items-center justify-between gap-3 text-xs text-ink-muted">
							<time datetime={post.data.pubDate.toISOString()}>
								{dateFormatter.format(post.data.pubDate)}
							</time>
							{post.data.draft && (
								<span class="rounded bg-ember/20 px-2 py-0.5 font-display text-[10px] tracking-wider text-ember-bright uppercase">
									Draft
								</span>
							)}
						</div>

						<h2 class="mb-3 font-display text-xl tracking-wide text-ink transition-colors group-hover:text-ember-bright sm:text-2xl">
							<a href={`/blog/${post.id}`}>
								<span class="absolute inset-0" aria-hidden="true" />
								{post.data.title}
							</a>
						</h2>

						<p class="mb-6 line-clamp-3 text-sm leading-relaxed text-ink-muted">
							{post.data.description}
						</p>

						{post.data.tags.length > 0 && (
							<div class="relative z-10 flex flex-wrap gap-2">
								{post.data.tags.map((tag) => (
									<span class="rounded-md border border-line bg-crust/80 px-2.5 py-1 font-mono text-[11px] text-ink-muted">
										#{tag}
									</span>
								))}
							</div>
						)}
					</article>
				))}
			</div>
		)}
	</main>

	<SiteFooter />
</Layout>
