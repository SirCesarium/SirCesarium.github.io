---
import silkscreenUrl from '@fontsource/silkscreen/files/silkscreen-latin-400-normal.woff2?url';
import { projects } from '../data/projects';
import { site } from '../data/site';

interface Props {
	title?: string;
	description?: string;
}

const { title = site.title, description = site.description } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? site.url);
const ogImageURL = new URL(site.ogImage, Astro.site ?? site.url);

const schemaGraph = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': `${site.url}/#website`,
			url: site.url,
			name: site.title,
			description: site.description,
			inLanguage: 'en-US',
			publisher: { '@id': `${site.url}/#person` },
		},
		{
			'@type': 'ProfilePage',
			'@id': `${canonicalURL.href}#profilepage`,
			url: canonicalURL.href,
			name: title,
			isPartOf: { '@id': `${site.url}/#website` },
			about: { '@id': `${site.url}/#person` },
			mainEntity: { '@id': `${site.url}/#person` },
		},
		{
			'@type': 'Person',
			'@id': `${site.url}/#person`,
			name: site.name,
			alternateName: [site.alias, 'SirCesarium'],
			jobTitle: site.role,
			description: site.description,
			url: site.url,
			image: ogImageURL.href,
			email: `mailto:${site.email}`,
			sameAs: [site.github, site.linkedin],
			address: {
				'@type': 'PostalAddress',
				addressCountry: site.countryCode,
				addressLocality: site.location,
			},
			knowsAbout: site.knowsAbout,
		},
		{
			'@type': 'BreadcrumbList',
			'@id': `${site.url}/#breadcrumb`,
			itemListElement: [
				{
					'@type': 'ListItem',
					position: 1,
					name: 'Home',
					item: `${site.url}/#top`,
				},
				{
					'@type': 'ListItem',
					position: 2,
					name: 'Work',
					item: `${site.url}/#work`,
				},
				{
					'@type': 'ListItem',
					position: 3,
					name: 'About',
					item: `${site.url}/#about`,
				},
				{
					'@type': 'ListItem',
					position: 4,
					name: 'Stack',
					item: `${site.url}/#stack`,
				},
				{
					'@type': 'ListItem',
					position: 5,
					name: 'Contact',
					item: `${site.url}/#contact`,
				},
			],
		},
		{
			'@type': 'ItemList',
			'@id': `${site.url}/#projects`,
			name: 'Featured Projects by Cesar Marcano',
			itemListElement: projects.map((project, index) => {
				const repo = project.links.find((l) => l.label === 'GitHub')?.href;
				return {
					'@type': 'ListItem',
					position: index + 1,
					item: {
						'@type': 'SoftwareSourceCode',
						name: project.name,
						description: project.tagline,
						programmingLanguage: project.stack,
						...(repo ? { codeRepository: repo } : {}),
						author: { '@id': `${site.url}/#person` },
					},
				};
			}),
		},
	],
};
---

<script is:inline>
	document.documentElement.classList.add('reveal-enabled');
</script>

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={site.name} />
<meta name="creator" content={site.name} />
<meta name="publisher" content={site.name} />
<meta name="keywords" content={site.keywords.join(', ')} />
<meta name="referrer" content="strict-origin-when-cross-origin" />
<meta name="theme-color" content="#0c0709" />
<meta name="color-scheme" content="dark" />

<meta
	name="robots"
	content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
/>
<meta
	name="googlebot"
	content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
/>

<link rel="canonical" href={canonicalURL} />
<link rel="alternate" hreflang="x-default" href={site.url} />
<link rel="alternate" hreflang="en" href={site.url} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={`${site.name} — Projects Feed`}
	href="/rss.xml"
/>
<link rel="alternate" type="text/markdown" href="/llms.txt" title="LLM Context" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="preload" href={silkscreenUrl} as="font" type="font/woff2" crossorigin />
<link rel="me" href={site.github} />
<link rel="me" href={site.linkedin} />

<!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
<meta property="og:type" content="profile" />
<meta property="profile:first_name" content="Cesar" />
<meta property="profile:last_name" content="Marcano" />
<meta property="profile:username" content="SirCesarium" />
<meta property="og:site_name" content={site.name} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:secure_url" content={ogImageURL} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${site.name} — ${site.role}`} />
<meta property="og:locale" content="en_US" />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={site.twitterHandle} />
<meta name="twitter:creator" content={site.twitterHandle} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
<meta name="twitter:image:alt" content={`${site.name} — ${site.role}`} />

<!-- Structured Data (JSON-LD) -->
<script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
<meta name="generator" content={Astro.generator} />
