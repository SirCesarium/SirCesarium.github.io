---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	name: string;
	video?: string;
	image?: ImageMetadata;
	imageFit?: 'cover' | 'contain';
	isWideBanner?: boolean;
	isCompact?: boolean;
	isLead?: boolean;
	visualShape: string;
	visualNameSize: string;
}

const {
	name,
	video,
	image,
	imageFit = 'cover',
	isWideBanner = false,
	isCompact = false,
	isLead = false,
	visualShape,
	visualNameSize,
} = Astro.props;
---

<div
	class:list={['project-visual relative overflow-hidden bg-[#0a0608]', visualShape]}
	aria-hidden="true"
>
	{video ? (
		<video
			src={video}
			poster={image?.src}
			muted
			loop
			playsinline
			preload="none"
			data-project-video
			aria-hidden="true"
			tabindex="-1"
			class="absolute inset-0 size-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.02] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
		/>
	) : image ? (
		<Image
			src={image}
			alt=""
			widths={isWideBanner ? [480, 720, 960, 1280, 1600] : [320, 480, 720, 960]}
			sizes={
				isWideBanner
					? '(min-width: 1280px) 1240px, 100vw'
					: isCompact
						? '9rem'
						: isLead
							? '(min-width: 768px) 55vw, 100vw'
							: '(min-width: 768px) 33vw, 100vw'
			}
			class:list={[
				'absolute inset-0 h-full w-full transition-transform duration-500 ease-out group-hover:scale-[1.02] motion-reduce:transition-none motion-reduce:group-hover:scale-100',
				isWideBanner || imageFit !== 'contain' ? 'object-cover' : 'object-contain',
			]}
			loading="lazy"
			decoding="async"
		/>
	) : (
		<>
			<div class="placeholder-grid" />
			<div class="placeholder-glow" />

			<div class="relative flex h-full flex-col p-3">
				{isCompact ? (
					<span class="m-auto font-display text-2xl leading-none text-ink">
						{name.slice(0, 1).toUpperCase()}
					</span>
				) : (
					<span
						class:list={[
							'm-auto max-w-full truncate px-2 font-display tracking-[0.08em] text-ink-muted',
							visualNameSize,
						]}
					>
						{name}
					</span>
				)}
			</div>
		</>
	)}
</div>

<style>
	.placeholder-grid {
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(to right, rgb(234 222 218 / 0.05) 1px, transparent 1px),
			linear-gradient(to bottom, rgb(234 222 218 / 0.05) 1px, transparent 1px);
		background-size: 32px 32px;
		mask-image: radial-gradient(ellipse at 50% 50%, black 20%, transparent 80%);
	}

	.placeholder-glow {
		position: absolute;
		inset: 0;
		background: radial-gradient(circle at 50% 50%, rgb(219 77 112 / 0.12), transparent 70%);
	}
</style>
