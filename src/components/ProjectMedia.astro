---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	name: string;
	video?: string;
	image?: ImageMetadata;
	imageFit?: 'cover' | 'contain';
	isWideBanner?: boolean;
	isCompact?: boolean;
	isLead?: boolean;
	visualShape: string;
	visualNameSize: string;
}

const {
	name,
	video,
	image,
	imageFit = 'cover',
	isWideBanner = false,
	isCompact = false,
	isLead = false,
	visualShape,
	visualNameSize,
} = Astro.props;

const posterImage =
	image && video ? await getImage({ src: image, width: 480, format: 'webp' }) : undefined;
---

<div
	class:list={['project-visual relative overflow-hidden bg-[#0a0608]', visualShape]}
	aria-hidden="true"
>
	{video ? (
		<video
			src={video}
			poster={posterImage?.src ?? image?.src}
			muted
			loop
			playsinline
			preload="none"
			data-project-video
			aria-hidden="true"
			tabindex="-1"
			class="absolute inset-0 size-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.02] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
		/>
	) : image ? (
		<Image
			src={image}
			alt=""
			widths={isWideBanner ? [480, 720, 960, 1280, 1600] : [320, 480, 720, 960]}
			sizes={
				isWideBanner
					? '(min-width: 1280px) 1240px, 100vw'
					: isCompact
						? '9rem'
						: isLead
							? '(min-width: 768px) 55vw, 100vw'
							: '(min-width: 768px) 33vw, 100vw'
			}
			class:list={[
				'absolute inset-0 size-full transition-transform duration-500 ease-out group-hover:scale-[1.02] motion-reduce:transition-none motion-reduce:group-hover:scale-100',
				imageFit === 'contain' ? 'p-3 object-contain sm:p-5' : 'object-cover',
			]}
		/>
	) : (
		<span
			class:list={[
				'project-visual-name select-none font-display text-white/5 uppercase',
				visualNameSize,
			]}
		>
			{name}
		</span>
	)}
	<div
		class="pointer-events-none absolute inset-0 bg-radial from-transparent to-black/35"
		aria-hidden="true"
	></div>
</div>

<style>
	.project-visual-name {
		position: absolute;
		bottom: -0.1em;
		right: 0.2em;
		line-height: 0.8;
		letter-spacing: -0.05em;
	}
</style>
