---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-line">
	<div class="frame flex flex-col gap-3 py-8 text-xs text-ink-muted sm:flex-row sm:items-center sm:justify-between">
		<p class="flex items-center gap-2">
			© {year} {site.name} ({site.alias}). All rights reserved.
		</p>

		<div class="flex flex-wrap items-center gap-4">
			<a href="#top" class="inline-flex items-center gap-1 transition-colors hover:text-ember">
				Back to top
				<span aria-hidden="true">↑</span>
			</a>
		</div>
	</div>
</footer>
