---
interface Props {
	href: string;
	variant?: 'solid' | 'outline';
	external?: boolean;
	class?: string;
}

const { href, variant = 'solid', external = false, class: className = '' } = Astro.props;

const tone =
	variant === 'solid'
		? 'border-ember bg-ember text-crust shadow-[3px_3px_0_0_color-mix(in_srgb,var(--color-ember)_45%,transparent)] hover:border-ember-bright hover:bg-ember-bright active:translate-x-0.75 active:translate-y-0.75 active:shadow-none'
		: 'border-ember/40 bg-transparent text-ember hover:border-ember/70 hover:bg-ember/10 active:translate-x-0.75 active:translate-y-0.75 active:shadow-[2px_2px_0_0_color-mix(in_srgb,var(--color-ember)_35%,transparent)]';

const cornerTone = variant === 'solid' ? 'border-ember-bright' : 'border-ember';

const cornerBase =
	'pointer-events-none absolute size-2 opacity-0 transition-[translate,opacity] duration-300 ease-out group-hover:translate-x-0 group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-x-0 group-focus-visible:translate-y-0 group-focus-visible:opacity-100';
---

<a
	href={href}
	target={external ? '_blank' : undefined}
	rel={external ? 'noopener noreferrer' : undefined}
	class:list={[
		'group relative inline-flex h-12 select-none items-center justify-center border px-5 text-base font-medium whitespace-nowrap transition-[background-color,border-color,translate,box-shadow] duration-150 ease-out',
		tone,
		className,
	]}
	data-press
>
	<span
		class:list={[
			cornerBase,
			cornerTone,
			'-top-1 -left-1 border-t-2 border-l-2 origin-top-left -translate-x-0.75 -translate-y-0.75',
		]}
	></span>
	<span
		class:list={[
			cornerBase,
			cornerTone,
			'-top-1 -right-1 border-t-2 border-r-2 origin-top-right translate-x-0.75 -translate-y-0.75',
		]}
	></span>
	<span
		class:list={[
			cornerBase,
			cornerTone,
			'-bottom-1 -left-1 border-b-2 border-l-2 origin-bottom-left -translate-x-0.75 translate-y-0.75',
		]}
	></span>
	<span
		class:list={[
			cornerBase,
			cornerTone,
			'-right-1 -bottom-1 border-r-2 border-b-2 origin-bottom-right translate-x-0.75 translate-y-0.75',
		]}
	></span>

	<slot />
</a>

<script src="../scripts/press-effect.ts"></script>
